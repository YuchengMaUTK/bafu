<view class="page">
  <view class="kicker">THE GOOD FORTUNE LIBRARY</view>
  <view class="page-title">好运图鉴</view><view class="subtitle">从签诗到幸运签条，慢慢读一段喜欢的话。</view>
  <scroll-view scroll-x="{{true}}" class="tabs" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="tab-row"><button wx:for="{{categories}}" wx:key="id" class="tab {{id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="category">{{item.name}} <text>{{item.count}}</text></button></view>
  </scroll-view>
  <input class="form-input" value="{{query}}" bindinput="search" placeholder="{{id === 'sign' ? '搜索签号、典故或签诗' : id === 'cookie' ? '搜索英文、中文或主题' : '搜索名称或关键词'}}" maxlength="100" />
  <view wx:if="{{id === 'sign'}}" class="grades"><button wx:for="{{grades}}" wx:key="*this" class="{{grade === item ? 'selected' : ''}}" data-grade="{{item}}" bindtap="grade">{{item || '全部签等'}}</button></view>
  <view class="small" style="margin:24rpx 0">{{items.length}} / {{total}} 份内容</view>
  <view wx:for="{{items}}" wx:key="index" class="catalogue-item" bindtap="open" data-index="{{item.index}}">
    <image class="catalogue-image" src="{{item.image}}" mode="aspectFit" /><view class="catalogue-copy"><view class="catalogue-title">{{item.title}}</view><view class="small">{{item.preview}}</view></view>
  </view>
  <view wx:if="{{!items.length}}" class="empty">没有找到这段内容，试试另一个关键词。</view>
</view>

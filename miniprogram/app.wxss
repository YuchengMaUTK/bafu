page{background:#faf8f2;color:#292820;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}
view,text,button,input,textarea{box-sizing:border-box}
button{font-size:26rpx;line-height:1.4;border-radius:22rpx;margin:0;padding:24rpx 28rpx;background:#f0eafa;color:#705396}
button::after{border:0}
button[disabled]{opacity:.5}
.page{padding:32rpx 30rpx 80rpx}
.brand{display:flex;align-items:center;gap:24rpx;margin-bottom:50rpx}
.wordmark{font-size:76rpx;font-weight:900;letter-spacing:-5rpx;transform:skew(-7deg);color:#292820}
.brand-copy{border-left:2rpx solid #dcd5e5;padding-left:24rpx;font-size:23rpx;line-height:1.6}
.purple{color:#7857a1;font-weight:700}
.kicker{font-size:19rpx;letter-spacing:3rpx;color:#82796b;margin-bottom:16rpx}
.heading{font-size:54rpx;font-weight:800;line-height:1.3;letter-spacing:-1rpx}
.subtitle{color:#7b796e;line-height:1.8;font-size:26rpx;margin-top:18rpx}
.primary{background:#7d59a8;color:#fff;font-weight:700;box-shadow:0 8rpx 18rpx #7d59a81a}
.secondary{background:#fffdf7;border:2rpx solid #ded3eb;color:#7857a1}
.quiet{background:transparent;padding:14rpx 10rpx;font-size:24rpx;color:#82796b}
.top-actions{display:flex;gap:16rpx;margin:28rpx 0}
.top-actions button{flex:1}
.progress-card{margin:30rpx 0;padding:28rpx;background:#f2ede3;border-radius:28rpx}
.progress-line{display:flex;justify-content:space-between;margin-bottom:18rpx}
.progress-track{height:12rpx;border-radius:20rpx;background:#ded7c9;overflow:hidden}
.progress-fill{height:100%;background:#c8a34e;transition:width .35s}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}
.buff{border:2rpx solid #e9e3d8;border-radius:28rpx;overflow:hidden;background:#fffdf7}
.buff-art{height:236rpx;padding:20rpx;position:relative}
.buff-art image{width:100%;height:100%}
.buff-number{position:absolute;top:15rpx;left:18rpx;font-size:17rpx;letter-spacing:1rpx;opacity:.65}
.buff-body{padding:22rpx}
.buff-name{font-size:30rpx;font-weight:750;margin-bottom:12rpx}
.buff-description{color:#82796b;font-size:23rpx;line-height:1.65;min-height:116rpx}
.buff-body button{width:100%;padding:18rpx 8rpx;margin-top:18rpx;font-size:23rpx}
.buff-links{display:flex;justify-content:space-between;flex-wrap:wrap;margin-top:12rpx;gap:12rpx}
.text-link{font-size:22rpx;padding:10rpx 0;color:#7d59a8}
.sendoff{margin-top:32rpx;padding:30rpx;background:#f9e7b7;border-radius:28rpx}
.sendoff-title{font-size:36rpx;font-weight:800;line-height:1.45;margin-bottom:18rpx}
.footer{margin:46rpx 0 0;text-align:center;font-size:23rpx;color:#8f897d;line-height:1.9}
.empty{padding:60rpx 24rpx;text-align:center;color:#82796b;line-height:1.9}
.panel{background:#fffdf7;border:2rpx solid #e9e3d8;border-radius:24rpx;padding:28rpx;margin-top:24rpx}
.page-title{font-size:46rpx;font-weight:800;margin:12rpx 0}
.actions{display:flex;gap:18rpx;margin:26rpx 0}
.actions button{flex:1}
.form-input{width:100%;padding:22rpx;background:#fffdf7;border:2rpx solid #ddd5e7;border-radius:18rpx;font-size:26rpx}
.form-textarea{height:240rpx}
.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.small{font-size:23rpx;color:#82796b;line-height:1.8}
.bold{font-weight:700}
